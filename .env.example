# Copy this file to .env and fill in the values.

# Google AI Studio key (https://aistudio.google.com/apikey). Leave empty to run without Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Server port (the Vite dev server proxies /api and /socket.io here)
PORT=3001

# Public MQTT broker used to reach the Wokwi roadside unit.
# The topic prefix must match MQTT_PREFIX in wokwi/sketch.ino.
MQTT_URL=mqtt://broker.hivemq.com:1883
MQTT_PREFIX=offguard/og-7k3q9x

# Web push contact (any mailto: or https: URL you control)
VAPID_SUBJECT=mailto:offguard@example.com
